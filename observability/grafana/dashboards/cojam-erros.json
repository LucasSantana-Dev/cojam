{
  "uid": "cojam-erros",
  "title": "CoJam: erros",
  "description": "O que deu errado, onde e quantas vezes. Logs do servidor (Loki) e contadores (Prometheus).",
  "tags": [
    "cojam",
    "erros"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "5m",
  "templating": {
    "list": [
      {
        "name": "ds_prometheus",
        "type": "datasource",
        "query": "prometheus",
        "regex": "/^Prometheus$/",
        "hide": 2,
        "refresh": 1,
        "current": {},
        "options": [],
        "includeAll": false,
        "multi": false
      },
      {
        "name": "ds_loki",
        "type": "datasource",
        "query": "loki",
        "regex": "",
        "hide": 2,
        "refresh": 1,
        "current": {},
        "options": [],
        "includeAll": false,
        "multi": false
      },
      {
        "name": "metodo",
        "label": "Método RPC",
        "description": "Filtra o painel de RPCs com erro por método.",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds_prometheus}"
        },
        "refresh": 2,
        "hide": 0,
        "definition": "label_values(music_jam_rpc_duration_seconds_count{job=\"cojam-server\"}, method)",
        "query": {
          "query": "label_values(music_jam_rpc_duration_seconds_count{job=\"cojam-server\"}, method)",
          "refId": "v"
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1,
        "options": []
      },
      {
        "name": "provedor",
        "label": "Provedor",
        "description": "Filtra o painel de falhas por provedor (youtube, spotify, deezer...).",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds_prometheus}"
        },
        "refresh": 2,
        "hide": 0,
        "definition": "label_values(music_jam_provider_requests_total{job=\"cojam-server\"}, provider)",
        "query": {
          "query": "label_values(music_jam_provider_requests_total{job=\"cojam-server\"}, provider)",
          "refId": "v"
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1,
        "options": []
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "cojam"
      ],
      "asDropdown": false,
      "title": "Dashboards do CoJam",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link"
    }
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Erros no log",
      "description": "Linhas de erro do servidor no período. Normal: 0. Preocupante: dezenas ou crescendo.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "sum(count_over_time({container_name=\"cojam-server\"} |= `\"level\":\"ERROR\"` [$__range])) or vector(0)",
          "legendFormat": "",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Avisos no log",
      "description": "Avisos não quebram nada, mas o mesmo aviso em volume indica algo a corrigir.",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "sum(count_over_time({container_name=\"cojam-server\"} |= `\"level\":\"WARN\"` [$__range])) or vector(0)",
          "legendFormat": "",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 50
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Panics",
      "description": "Normal: 0 sempre. Qualquer valor acima de 0 é bug de código: veja a linha goroutine_panic nos logs.",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "sum(increase(music_jam_goroutine_panics_total{job=\"cojam-server\"}[$__range])) or vector(0)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "RPCs com erro do servidor",
      "description": "Falhas causadas pelo servidor (não conta erro de uso, como pedir algo sem permissão).",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "sum(increase(music_jam_rpc_duration_seconds_count{job=\"cojam-server\",status=\"error\"}[$__range])) or vector(0)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "id": 4
    },
    {
      "type": "stat",
      "title": "Eventos descartados",
      "description": "Eventos de produto perdidos (buffer cheio ou erro de banco). Normal: 0. Se subir, os painéis de negócio estão subcontando.",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "sum(increase(music_jam_events_dropped_total{job=\"cojam-server\",reason!=\"disabled\"}[$__range])) or vector(0)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "id": 5
    },
    {
      "type": "stat",
      "title": "Alertas disparando",
      "description": "",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "count(ALERTS{alertstate=\"firing\", alertname=~\"CoJam.*\"}) or vector(0)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "id": 6
    },
    {
      "type": "row",
      "title": "Logs",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 1
      },
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Erros e avisos no log por minuto",
      "description": "Normal: quase vazio. Preocupante: pico que não passa ou barras todo minuto.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "sum(count_over_time({container_name=\"cojam-server\"} |= `\"level\":\"ERROR\"` [$__auto]))",
          "legendFormat": "erro",
          "queryType": "range",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "sum(count_over_time({container_name=\"cojam-server\"} |= `\"level\":\"WARN\"` [$__auto]))",
          "legendFormat": "aviso",
          "queryType": "range",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "erro"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "aviso"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 8
    },
    {
      "type": "table",
      "title": "Erros por mensagem (Top 15)",
      "description": "Mensagem do log e quantas vezes apareceu. msg conhecidas: rpc, store_save_failed, publish_failed, goroutine_panic, youtube_quota_exhausted.",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "topk(15, sum by (msg) (count_over_time({container_name=\"cojam-server\"} |~ `\"level\":\"(ERROR|WARN)\"` | json msg=\"msg\", level=\"level\" | level=\"ERROR\" [$__range])))",
          "legendFormat": "",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "Nenhum erro no período"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Vezes"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "msg": "Mensagem",
              "Value #A": "Vezes"
            },
            "indexByName": {
              "msg": 0,
              "Value #A": 1
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Vezes",
                "desc": true
              }
            ]
          }
        }
      ],
      "id": 9
    },
    {
      "type": "table",
      "title": "Avisos por mensagem (Top 15)",
      "description": "transport_absent e stale_transport_advanced indicam sala tocando sem relógio de sincronia (veja alerta CoJamPlayingWithoutTransport).",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "topk(15, sum by (msg) (count_over_time({container_name=\"cojam-server\"} |~ `\"level\":\"(ERROR|WARN)\"` | json msg=\"msg\", level=\"level\" | level=\"WARN\" [$__range])))",
          "legendFormat": "",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "Nenhum aviso no período"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Vezes"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "msg": "Mensagem",
              "Value #A": "Vezes"
            },
            "indexByName": {
              "msg": 0,
              "Value #A": 1
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Vezes",
                "desc": true
              }
            ]
          }
        }
      ],
      "id": 10
    },
    {
      "type": "logs",
      "title": "Linhas de erro recentes (mais novas primeiro)",
      "description": "Clique numa linha para ver request_id e room_id e procurar o mesmo request_id nos outros logs.",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 11
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "{container_name=\"cojam-server\"} |= `\"level\":\"ERROR\"`",
          "legendFormat": "",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "prettifyLogMessage": true
      },
      "id": 11
    },
    {
      "type": "row",
      "title": "RPCs e provedores",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 1
      },
      "id": 12
    },
    {
      "type": "timeseries",
      "title": "RPCs com erro do servidor por método",
      "description": "Só status=error (falha do servidor). Normal: vazio. Preocupante: um método concentrando as falhas. Dropdown Método RPC filtra.",
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "sum by (method) (increase(music_jam_rpc_duration_seconds_count{job=\"cojam-server\",status=\"error\",method=~\"$metodo\"}[$__rate_interval]))",
          "legendFormat": "{{method}}",
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 13
    },
    {
      "type": "timeseries",
      "title": "Falhas por provedor (status diferente de ok)",
      "description": "quota = cota esgotada; ratelimit = pedimos demais; timeout = provedor lento; error = resposta ruim. Normal: poucas. Preocupante: uma série dominando por horas.",
      "gridPos": {
        "x": 12,
        "y": 33,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "sum by (provider, op, status) (increase(music_jam_provider_requests_total{job=\"cojam-server\",status!=\"ok\",provider=~\"$provedor\"}[$__rate_interval]))",
          "legendFormat": "{{provider}} {{op}} {{status}}",
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 14
    },
    {
      "type": "timeseries",
      "title": "Cota do YouTube: vezes que o freio abriu",

{
  "uid": "cojam-negocio",
  "title": "CoJam: negócio",
  "description": "Uso real do CoJam: salas, entradas, o que toca, pulos e retenção. Fonte: tabela product_events (Postgres, somente leitura).",
  "tags": [
    "cojam",
    "negocio"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "5m",
  "templating": {
    "list": [
      {
        "name": "ds_prometheus",
        "type": "datasource",
        "query": "prometheus",
        "regex": "/^Prometheus$/",
        "hide": 2,
        "refresh": 1,
        "current": {},
        "options": [],
        "includeAll": false,
        "multi": false
      },
      {
        "name": "ds_loki",
        "type": "datasource",
        "query": "loki",
        "regex": "",
        "hide": 2,
        "refresh": 1,
        "current": {},
        "options": [],
        "includeAll": false,
        "multi": false
      },
      {
        "name": "provedor",
        "label": "Provedor da faixa",
        "description": "Filtra os painéis de faixas tocadas por provedor de origem da faixa.",
        "type": "custom",
        "hide": 0,
        "query": "youtube,spotify,other",
        "includeAll": true,
        "allValue": "youtube,spotify,other",
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "cojam"
      ],
      "asDropdown": false,
      "title": "Dashboards do CoJam",

    {
      "type": "timeseries",
      "title": "Músicas por sala por dia",
      "description": "Média de músicas iniciadas por sala que tocou algo no dia. Normal: acima de 3. Preocupante: perto de 1 (a sala toca uma música e acaba).",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cojam-postgres"

    {
      "type": "timeseries",
      "title": "Pulos por voto (contador do servidor)",
      "description": "Dados do Prometheus (reinicia a contagem quando o servidor reinicia). Votos muito acima de pulos = a sala vota e não chega ao limite.",
      "gridPos": {
        "x": 18,
        "y": 26,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "sum(increase(music_jam_skips_by_vote_total{job=\"cojam-server\"}[$__rate_interval]))",
          "legendFormat": "pulos por voto",
          "instant": false,
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "sum(increase(music_jam_skip_votes_total{job=\"cojam-server\"}[$__rate_interval]))",
          "legendFormat": "votos para pular",
          "instant": false,
          "range": true,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {

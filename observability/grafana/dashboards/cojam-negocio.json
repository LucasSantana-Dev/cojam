    {
      "type": "timeseries",
      "title": "Salas criadas, entradas e salas com 2+ pessoas por dia",
      "description": "Normal: entradas maiores que salas criadas e algumas salas com 2+ pessoas. Preocupante: salas criadas sem entradas de outras pessoas (ninguém convida) ou nenhuma sala com 2+.",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cojam-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cojam-postgres"
          },
          "rawSql": "SELECT date_trunc('day', at) AS time, count(*) FILTER (WHERE name = 'room_created') AS \"Salas criadas\", count(*) FILTER (WHERE name = 'room_joined') AS \"Entradas\", count(DISTINCT room_hash) FILTER (WHERE name = 'listener_peak' AND (props->>'n')::int >= 2) AS \"Salas com 2+ pessoas\" FROM product_events WHERE name IN ('room_created','room_joined','listener_peak') AND $__timeFilter(at) GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 9
    },

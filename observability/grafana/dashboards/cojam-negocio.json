        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cojam-postgres"
          },
          "rawSql": "SELECT date_trunc('day', at) AS time, round(count(*)::numeric / nullif(count(DISTINCT room_hash), 0), 1) AS \"Músicas por sala\" FROM product_events WHERE name = 'track_started' AND $__timeFilter(at) GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
